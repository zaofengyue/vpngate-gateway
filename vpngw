def _menu_manual_connect():
    nodes = _read_json(NODES_FILE, [])
    if not nodes:
        print(yellow("\n  暂无节点\n"))
        input("  按 Enter 继续...")
        return
    print()
    for i, n in enumerate(nodes[:20], 1):
        active = green("▶") if n.get("active") else " "
        lat = n.get("latency_ms", 0)
        lat_s = (green if lat<100 else yellow)(f"{lat}ms")
        print(f"  {active}{i:>2}. [{n.get('country_code','??')}] {n['ip']:<15} {lat_s:>6}  {n.get('country','')}")
    print()
    sel = input("  选择序号（留空=取消）: ").strip()
    if sel.isdigit() and 1 <= int(sel) <= min(20, len(nodes)):
        ok, msg = _send_cmd("connect", [nodes[int(sel)-1]["id"]], timeout=60)
        _print_result(ok, msg)
    input("  按 Enter 继续...")

# ── 主入口 ────────────────────────────────────────────────────────────────────
def main():
    parser = argparse.ArgumentParser(prog="vg")
    sub = parser.add_subparsers(dest="subcmd")

    def _add(name, **kw):
        p = sub.add_parser(name, **kw)
        return p

    p = _add("status");        p.add_argument("--check", action="store_true"); p.set_defaults(func=lambda a: cmd_status(a))
    p = _add("fetch");         p.add_argument("--country"); p.add_argument("--top",type=int); p.set_defaults(func=lambda a: cmd_fetch(a))
    p = _add("nodes");         p.add_argument("--country"); p.add_argument("-n","--limit",type=int,default=30); p.set_defaults(func=lambda a: cmd_nodes(a))
    p = _add("auto");          p.add_argument("country",nargs="?"); p.set_defaults(func=lambda a: cmd_auto(a))
    p = _add("connect");       p.add_argument("node_id"); p.set_defaults(func=lambda a: cmd_connect(a))
    p = _add("rotate");        p.set_defaults(func=lambda a: cmd_rotate(a))
    p = _add("stop");          p.set_defaults(func=lambda a: cmd_stop(a))
    p = _add("logs");          p.add_argument("-n","--lines",type=int,default=50); p.set_defaults(func=lambda a: cmd_logs(a))
    p = _add("set");           p.add_argument("key"); p.add_argument("value", nargs="?"); p.set_defaults(func=lambda a: cmd_set(a))
    p = _add("restart");       p.set_defaults(func=lambda a: cmd_service(type("A",(),{"action":"restart"})()))
    p = _add("service");       p.add_argument("action",nargs="?"); p.set_defaults(func=lambda a: cmd_service(a))
    p = _add("check-latency"); p.set_defaults(func=lambda a: cmd_check_latency(a))
    p = _add("uninstall");     p.set_defaults(func=lambda a: cmd_uninstall(a))

    args = parser.parse_args()
    if args.subcmd is None:
        cmd_menu()
    else:
        args.func(args)

if __name__ == "__main__":
    main()
