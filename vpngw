_CRED_RE = re.compile(r"^[A-Za-z0-9._~!@#%^*+=\-]{1,128}$")
_CLEAR = ("", "off", "none", "-")

def _validate_setting(key, val):
    """返回错误信息；合法返回 None"""
    if key in ("proxy_user", "proxy_pass") and val != "" and not _CRED_RE.match(val):
        return "只允许字母数字和 . _ ~ ! @ # % ^ * + = -，长度 1-128（不含冒号/空格/引号）"
    if key == "proxy_port" and not (1 <= val <= 65535):
        return "端口范围 1-65535"
    if key == "dns_servers":
        import socket as _s
        items = [x.strip() for x in str(val).split(",") if x.strip()]
        for x in items:
            try: _s.inet_pton(_s.AF_INET, x)
            except OSError: return f"不是合法的 IPv4 地址: {x}"
        if not items: return "至少需要一个 DNS 服务器"
    if key == "run_as_user" and val not in ("", "root"):
        try: pwd.getpwnam(val)
        except KeyError: return f"系统用户 {val} 不存在"
    return None

def cmd_set(args=None, pause=False):
    settings = _read_json(SETTINGS_FILE, {})
    defaults = {"country_filter":[],"rotate_hours":2,"latency_check_hours":1,"min_nodes":5,
                "top_nodes":20,"probe_count":10,"proxy_port":7928,"auto_fetch_on_start":True,
                "outlet_check_interval":60,"outlet_max_fails":3,
                "dns_servers":"1.1.1.1,8.8.8.8","proxy_user":"","proxy_pass":"",
                "run_as_user":SERVICE_USER}
    defaults.update(settings)
    show = lambda k: ("******" if defaults.get(k) else "") if k == "proxy_pass" else defaults.get(k, "")

    key   = getattr(args, "key", None) if args else None
    value = getattr(args, "value", None) if args else None

    if not key:
        print()
        print(bold("  当前设置（输入序号修改）："))
        print()
        for i, (k, name, desc, typ) in enumerate(SETTINGS_DEF, 1):
            print(f"  {cyan(str(i))}. {bold(name):<14} = {yellow(str(show(k)))}")
            print(f"     {dim(desc)}")
            print()
        print(f"  {cyan('0')}. 返回")
        print()
        sel = input("  选择序号: ").strip()
        if sel == "0" or not sel: return
        if sel.isdigit() and 1 <= int(sel) <= len(SETTINGS_DEF):
            k, name, desc, typ = SETTINGS_DEF[int(sel)-1]
            key = k
            print(f"\n  当前值: {yellow(str(show(k)))}  {dim(desc)}")
            value = (getpass.getpass("  新值（隐藏输入）: ") if typ == "secret" else input("  新值: ")).strip()
        else:
            print(red("  无效选择"))
            if pause: input("  按 Enter 继续...")
            return

    entry = next((e for e in SETTINGS_DEF if e[0] == key), None)
    if not entry:
        print(red(f"\n  未知设置项: {key}\n"))
        if pause: input("  按 Enter 继续...")
        return

    _, name, _, typ = entry
    if value is None:                      # vg set proxy_pass（不带值）：隐藏输入，口令不进 shell 历史和 ps
        if typ != "secret":
            print(red(f"\n  请提供新值: vg set {key} <值>\n"))
            return
        value = getpass.getpass("  新值（隐藏输入）: ").strip()
    if typ in ("str", "secret") and key in ("proxy_user", "proxy_pass") and value.lower() in _CLEAR:
        value = ""
    try:
        if   typ == "list":  new_val = [x.strip().upper() for x in value.split(",") if x.strip()] if value else []
        elif typ == "bool":  new_val = value.lower() in ("true","1","yes")
        elif typ == "int":   new_val = int(value)
        elif typ == "float": new_val = float(value)
        else:                new_val = value
    except ValueError:
        print(red(f"\n  值格式错误\n"))
        if pause: input("  按 Enter 继续...")
        return

    err = _validate_setting(key, new_val)
    if err:
        print(red(f"\n  ✘ {err}\n"))
        if pause: input("  按 Enter 继续...")
        return
    defaults[key] = new_val
    if bool(defaults.get("proxy_user")) != bool(defaults.get("proxy_pass")):
        print(yellow("\n  ⚠ proxy_user 与 proxy_pass 需要同时设置，只设一个时服务会拒绝启动"))
    _write_json(SETTINGS_FILE, defaults)
    print(green(f"\n  ✔ {name} 已设置为: {'******' if typ == 'secret' and new_val else new_val}"))
    print(dim("  部分设置需重启服务生效: vg restart\n"))
    if pause: input("  按 Enter 继续...")

