            class A: lines=int(lm) if lm.isdigit() else 50
            cmd_logs(A(), pause=True)
        elif choice == "0":
            cmd_set(pause=True)
        elif choice == "10":
            cmd_service(pause=True)
        elif choice == "11":
            cmd_uninstall(pause=True)
        elif choice == "00":
