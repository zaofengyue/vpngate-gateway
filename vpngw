# ── logs ──────────────────────────────────────────────────────────────────────
def cmd_logs(args=None, pause=False):
    n = getattr(args, "lines", 50) if args else 50
    if LOG_FILE.exists():
        lines = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
        print()
        for line in lines[-n:]:
            if any(k in line for k in ["失败","错误","Error"]):   print(red(f"  {line}"))
            elif any(k in line for k in ["成功","已连接","启动"]): print(green(f"  {line}"))
            elif any(k in line for k in ["警告","超时"]):          print(yellow(f"  {line}"))
            else:                                                   print(f"  {line}")
        print()
    else:
        print(yellow("\n  日志文件不存在\n"))
    if pause: input("  按 Enter 继续...")

# ── 服务管理 ──────────────────────────────────────────────────────────────────
def cmd_service(args=None, pause=False):
    action = getattr(args, "action", None) if args else None
    if not action:
        print()
        print(bold("  服务管理"))
        print("  1. 重启服务")
        print("  2. 停止服务")
        print("  3. 启动服务")
        print("  4. 快捷重装")
        print("  0. 返回")
        print()
        choice = input("  选择: ").strip()
        if choice == "0" or not choice:
            return
        elif choice == "1": action = "restart"
        elif choice == "2": action = "stop"
        elif choice == "3": action = "start"
        elif choice == "4":
            _reinstall()
            if pause: input("  按 Enter 继续...")
            return
        else:
            print(red("  无效选择"))
            if pause: input("  按 Enter 继续...")
            return

    if action not in ("restart", "stop", "start"):
        _print_result(False, f"不支持的操作: {action}（可用: restart / stop / start）")
        if pause: input("  按 Enter 继续...")
        return

    action_name = {"restart":"重启","stop":"停止","start":"启动"}[action]
    print(f"\n  正在{action_name}服务...\n")
    ok, msg = _service_ctl(action)
    if ok:
        time.sleep(2)
        _print_result(True, f"服务已{action_name}")
        print(f"  当前状态: {green('运行中') if _service_running() else red('已停止')}\n")
    else:
        _print_result(False, msg or "操作失败")
    if pause: input("  按 Enter 继续...")

def _reinstall():
    """
    更新程序文件（保留依赖和数据）。下载对应版本的 install.sh 并以 --files-only 运行：
    安装器会按其内置的 SHA256 清单校验其余文件，校验不通过不会替换任何东西。
    固定版本：VPNGATE_REF=<tag 或 commit> vg service
    """
    ref = os.environ.get("VPNGATE_REF", "main")
    base = os.environ.get("VPNGATE_RAW_BASE") or f"https://raw.githubusercontent.com/{GITHUB_REPO}/{ref}"
    url = f"{base}/install.sh"
    print(f"\n  正在更新（版本: {ref}，保留依赖和数据）...\n")
    tmpdir = tempfile.mkdtemp(prefix="vpngw-")
    script = os.path.join(tmpdir, "install.sh")
    try:
        r = subprocess.run(["curl", "-fsSL", url, "-o", script], capture_output=True, text=True)
        if r.returncode != 0:
            _print_result(False, f"下载安装器失败: {r.stderr.strip() or r.returncode}")
            return
        r = subprocess.run(["bash", script, "--files-only"], env={**os.environ, "VPNGATE_REF": ref})
        if r.returncode == 0:
            time.sleep(2)
            _print_result(True, f"更新完成，服务{'已运行' if _service_running() else '未运行'}")
        else:
            _print_result(False, "更新失败（哈希校验未通过或下载出错），已保留现有文件")
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)

# ── 卸载 ──────────────────────────────────────────────────────────────────────
def cmd_uninstall(args=None, pause=False):
    print()
    print(bold("  卸载选项"))
    print("  1. 卸载服务")
    print("  2. 彻底卸载（清理本服务并卸载 openvpn）")
    print("  0. 取消")
    print()
    choice = input("  选择: ").strip()
    if choice == "0": return
    if choice not in ("1","2"):
        print(red("  无效选择")); return

    if input(f"\n  确认{'卸载服务' if choice=='1' else '彻底卸载'}？[y/N] ").strip().lower() != "y":
        print("  已取消"); return

    init = _init_system()
    _service_ctl("stop")
    if init == "systemd":
        subprocess.run(["systemctl","disable",SERVICE], capture_output=True)
    elif init == "openrc":
        subprocess.run(["rc-update","del",SERVICE,"default"], capture_output=True)
    if shutil.which("pkill"):
        subprocess.run(["pkill","-f","openvpn.*vpngate-gateway"], capture_output=True)

    import shutil as _sh
    for f in ["/etc/systemd/system/vpngate-gateway.service",
              "/lib/systemd/system/vpngate-gateway.service",
              "/etc/init.d/vpngate-gateway",
              "/var/log/vpngate-gateway.err",
              "/etc/sysctl.d/99-vpngate-rpfilter.conf"]:
        try: os.unlink(f)
        except OSError: pass
    if init == "systemd":
        subprocess.run(["systemctl","daemon-reload"], capture_output=True)
    for f in ["/usr/local/bin/vpngw","/usr/local/bin/vg"]:
        try: os.unlink(f)
        except OSError: pass
    try:
        _sh.rmtree(str(INSTALL_DIR))
        print(green("  ✔ 安装目录已删除"))
    except Exception as e:
        print(red(f"  ✘ 删除安装目录失败: {e}"))
    try:
        pwd.getpwnam(SERVICE_USER)
        if shutil.which("userdel"):
            subprocess.run(["userdel", SERVICE_USER], capture_output=True)
        elif shutil.which("deluser"):
            subprocess.run(["deluser", SERVICE_USER], capture_output=True)
        print(green(f"  ✔ 服务用户 {SERVICE_USER} 已删除"))
    except KeyError:
        pass

    if choice == "2":
        if shutil.which("apt-get"):
            pkg_cmd = ["apt-get", "remove", "-y", "openvpn"]
        elif shutil.which("apk"):
            pkg_cmd = ["apk", "del", "openvpn"]
        else:
            pkg_cmd = None
        if pkg_cmd:
            r = subprocess.run(pkg_cmd, capture_output=True, text=True)
            print(green("  ✔ openvpn 依赖已卸载") if r.returncode == 0 else yellow("  ⚠ openvpn 卸载部分失败"))
        else:
            print(yellow("  ⚠ 未识别包管理器，请手动卸载 openvpn"))

    print(green("\n  ✔ 卸载完成\n"))

