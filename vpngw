_tty = sys.stdout.isatty()
def _c(code, t): return f"\033[{code}m{t}\033[0m" if _tty else t
def red(t):    return _c("0;31", t)
def green(t):  return _c("0;32", t)
def yellow(t): return _c("1;33", t)
def cyan(t):   return _c("0;36", t)
def bold(t):   return _c("1", t)
def dim(t):    return _c("2", t)

def _read_json(path, default=None):
    try: return json.loads(path.read_text(encoding="utf-8"))
    except: return default

def _service_ids():
    """服务降权运行的用户（settings.run_as_user，默认 vpngate）的 uid/gid；不存在返回 None"""
    name = (_read_json(SETTINGS_FILE, {}) or {}).get("run_as_user", SERVICE_USER) or SERVICE_USER
    try:
        pw = pwd.getpwnam(name)
        return pw.pw_uid, pw.pw_gid
    except KeyError:
        return None

def _write_json(path, data):
    """原子写入；文件以 0600 创建（settings.json 里可能有代理口令），root 写入时把属主交给服务用户"""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(json.dumps(data, ensure_ascii=False, indent=2))
    if os.geteuid() == 0:
        ids = _service_ids()
        if ids:
            os.chown(tmp, *ids)
    tmp.replace(path)

SERVICE = "vpngate-gateway"

def _init_system():
    """systemd（Debian/Ubuntu）/ openrc（Alpine）/ none"""
    if shutil.which("systemctl") and os.path.isdir("/run/systemd/system"):
        return "systemd"
    if shutil.which("rc-service"):
        return "openrc"
    return "none"

def _manager_pids():
    """通过 /proc 查找 vpngate_manager.py 进程（无服务管理器时的兜底）"""
    pids = []
    try:
        for d in os.listdir("/proc"):
            if not d.isdigit() or int(d) == os.getpid():
                continue
            try:
                with open(f"/proc/{d}/cmdline", "rb") as f:
                    args = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
            except OSError:
                continue
            # 解释器必须是 python，且有参数的文件名恰好是 vpngate_manager.py
            # （避免把 vim/tail 等碰巧带这个文件名的进程误判成服务）
            if (len(args) >= 2
                    and os.path.basename(args[0]).startswith("python")
                    and any(os.path.basename(a) == "vpngate_manager.py" for a in args[1:])):
                pids.append(int(d))
    except OSError:
        pass
    return pids

def _service_running():
    init = _init_system()
    try:
        if init == "systemd":
            r = subprocess.run(["systemctl", "is-active", SERVICE], capture_output=True, text=True)
            return r.stdout.strip() == "active"
        if init == "openrc":
            r = subprocess.run(["rc-service", SERVICE, "status"], capture_output=True, text=True)
            return r.returncode == 0
    except OSError:
        pass
    return bool(_manager_pids())

def _service_ctl(action):
    """start / stop / restart，返回 (ok, message)"""
    init = _init_system()
    if init == "systemd":
        cmd = ["systemctl", action, SERVICE]
    elif init == "openrc":
        cmd = ["rc-service", SERVICE, action]
    else:
        return False, "未检测到 systemd 或 OpenRC，无法管理服务"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        return False, str(e)
    return r.returncode == 0, (r.stderr.strip() or r.stdout.strip())

def _send_cmd(cmd, args=[], timeout=120):
    if not DATA_DIR.exists():
        return False, "数据目录不存在"
    ts = time.time()
    _write_json(CMD_FILE, {"cmd": cmd, "args": args, "ts": ts})
    spinner = ["|","/","-","\\"]
    i = 0
    while time.time() < ts + timeout:
        time.sleep(0.3)
        r = _read_json(CMD_RESULT, {})
        if r.get("ts", 0) > ts:
            if _tty: print("\r" + " "*30 + "\r", end="", flush=True)
            return r.get("ok", False), r.get("msg", "")
        if _tty:
            print(f"\r  {spinner[i%4]} 等待响应...", end="", flush=True)
            i += 1
    if _tty: print()
    return False, f"命令超时（{timeout}s）"

def _print_result(ok, msg):
    print()
    print(f"  {green('✔') if ok else red('✘')} {msg}")
    print()

# ── status ────────────────────────────────────────────────────────────────────
def cmd_status(args=None, pause=False):
    state   = _read_json(STATE_FILE, {})
    nodes   = _read_json(NODES_FILE, [])
    active  = state.get("active_node_id", "")
    running = _service_running()
    s       = _read_json(SETTINGS_FILE, {})
    port    = s.get("proxy_port", 7928)

    print()
    print(bold("─" * 52))
    print(bold("  VPNGate Gateway 状态"))
    print(bold("─" * 52))
    print(f"  服务状态  {green('● 运行中') if running else red('● 已停止')}")

    if active:
        node = next((n for n in nodes if n["id"] == active), None)
        if node:
            lat = node.get("latency_ms", 0)
            print(f"  连接节点  {green(active)}")
            print(f"  节点 IP   {cyan(node.get('ip',''))}")
            print(f"  国家      {node.get('country', node.get('country_code',''))}")
            print(f"  延迟      {(green if lat<100 else yellow)(str(lat))} ms")
            if node.get("isp"):
                print(f"  ISP       {dim(node.get('isp',''))}")
    else:
        print(f"  连接节点  {yellow('未连接')}")

    if state.get("message"):
        print(f"  消息      {dim(state['message'])}")
    if state.get("connected_at"):
        dt = time.time() - state["connected_at"]
        print(f"  连接时长  {int(dt//3600)}h {int((dt%3600)//60)}m")

    print(f"  代理端口  {cyan(str(port))}")
    print(f"  节点数量  {len(nodes)} 个")

    check = getattr(args, "check", False) if args else False
    if check or pause:
        print()
        print(f"  检测出口 IP...", end="", flush=True)
        ip = direct = ""
        if vpn_utils:
            ip = vpn_utils.check_proxy(port, str(s.get("proxy_user", "")),
                                       str(s.get("proxy_pass", "")), 8)["ip"]
            if ip:
                direct = vpn_utils.direct_ip(6)
        if ip:
            print(f"\r  出口 IP   {green(ip)}          ")
            if direct and direct == ip:
                print(f"  {red('⚠ 出口 IP 与本机真实 IP 相同 —— 流量可能没有走 VPN，请立即检查！')}")
            elif direct:
                print(f"  真实 IP   {dim(direct)} {dim('（与出口不同，正常）')}")
        else:
            print(f"\r  出口 IP   {red('检测失败')}            ")
        if s.get("proxy_user"):
            print(f"  代理认证  {green('已启用')}")
        else:
            print(f"  代理认证  {yellow('未启用')} {dim('（同机所有用户都能使用此代理，建议 vg set proxy_user / proxy_pass）')}")

    print(bold("─" * 52))
    print()
    if pause: input("  按 Enter 继续...")

# ── fetch ─────────────────────────────────────────────────────────────────────
def cmd_fetch(args=None, pause=False):
    country = getattr(args, "country", None) if args else None
    top     = getattr(args, "top", None) if args else None
    cmd_args = []
    if country: cmd_args.append(country)
    if top:     cmd_args.append(str(top))
    desc = f"{'国家:'+country+' ' if country else ''}{'前'+str(top)+'个' if top else ''}"
    print(f"\n  正在抓取节点{'（'+desc+'）' if desc else ''}...\n")
    ok, msg = _send_cmd("fetch", cmd_args, timeout=180)
    _print_result(ok, msg)
    if ok: cmd_status(pause=False)
    if pause: input("  按 Enter 继续...")

